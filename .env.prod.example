ENV=production
SECRET_KEY=cambia_esto_por_un_secreto_de_64_chars_minimo

# Base de datos
POSTGRES_DB=xpacio
POSTGRES_USER=xpacio
POSTGRES_PASSWORD=cambia_esto_password_segura
DATABASE_URL=postgresql+asyncpg://xpacio:cambia_esto_password_segura@db:5432/xpacio

# Redis
REDIS_PASSWORD=cambia_esto_redis_password
REDIS_URL=redis://:cambia_esto_redis_password@redis:6379/0

# MinIO (almacenamiento de imágenes)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=cambia_esto_minio_user
MINIO_SECRET_KEY=cambia_esto_minio_password_minimo_12_chars
MINIO_BUCKET=xpacio-spaces
MINIO_USE_SSL=false

# Google Maps
GOOGLE_MAPS_API_KEY=tu_api_key_de_google_maps

# URLs del frontend (para cookies y CORS)
FRONTEND_URL=https://xpacio.cl

# Stripe (pagos)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=https://xpacio.cl/reserva/confirmacion?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://xpacio.cl/reserva/cancelada

# Transbank
TRANSBANK_COMMERCE_CODE=tu_commerce_code
TRANSBANK_API_KEY=tu_api_key
TRANSBANK_ENV=production
TRANSBANK_RETURN_URL=https://xpacio.cl/reserva/confirmacion

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password
FROM_EMAIL=noreply@xpacio.cl

# Google Calendar (opcional)
GOOGLE_SERVICE_ACCOUNT_JSON={}
GOOGLE_CALENDAR_ID=
